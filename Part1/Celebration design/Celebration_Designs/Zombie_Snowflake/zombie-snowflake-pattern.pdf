<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 4.2.2-c063 53.351735, 2008/07/22-18:11:12        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">6pt-zombie-snowflake-pattern</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Buz Carter</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Enough with safe water crystals -- cut your own zombie snowflake. Print this template on thin, stiff paper, fold along dotted lines, and cut out the zombie-flake along the solid line. Ta-dah! A zombie snowflake that'll fit right in with those other kid's dull, conventional winter decorations.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>zombie</rdf:li>
               <rdf:li>snowflake</rdf:li>
               <rdf:li>snow</rdf:li>
               <rdf:li>flake</rdf:li>
               <rdf:li>papercraft</rdf:li>
               <rdf:li>origama</rdf:li>
               <rdf:li>diy</rdf:li>
               <rdf:li>paper</rdf:li>
               <rdf:li>craft</rdf:li>
               <rdf:li>free</rdf:li>
               <rdf:li>template</rdf:li>
               <rdf:li>guide</rdf:li>
               <rdf:li>fold</rdf:li>
               <rdf:li>buz carter</rdf:li>
            </rdf:Bag>
         </dc:subject>
