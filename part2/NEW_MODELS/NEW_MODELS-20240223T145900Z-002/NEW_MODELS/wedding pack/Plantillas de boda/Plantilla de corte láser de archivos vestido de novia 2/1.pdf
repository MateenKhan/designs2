         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Laser cut with Wedding set of ornate cards. Template for greeting card ,wedding, invitation, bookmark and label with space for your text. Vector illustration design.</rdf:li>
            </rdf:Alt>
         </dc:description>
